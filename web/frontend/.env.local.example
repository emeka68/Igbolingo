# Only needed for MOBILE (Capacitor) builds or when the backend is hosted
# elsewhere. Leave unset for normal web dev — the Vite proxy handles /api.
#
# Testing on a real phone (same Wi-Fi as your Mac):
#   1. Find your Mac's LAN IP:  ipconfig getifaddr en0
#   2. VITE_API_URL=http://192.168.x.x:8001
#   3. Start the backend listening on all interfaces:
#      uvicorn main:app --host 0.0.0.0 --port 8001
#   4. npm run build && npx cap sync
#
# Production: set this to your deployed backend URL.
VITE_API_URL=
